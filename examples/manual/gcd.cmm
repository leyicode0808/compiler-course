int gcd(int a, int b)
{
    int t;
    if (a < b)
    {
        t = a;
        a = b;
        b = t;
    }
    while (b != 0)
    {
        t = a - (a / b) * b;
        a = b;
        b = t;
    }
    return a;
}

int main()
{
    int x;
    int y;
    int result;
    x = read();
    y = read();
    result = gcd(x, y);
    write(result);
    return 0;
}
